# Access code the marketing team enters on the access screen.
# Set the real value in your deployment environment — never commit it.
MARKETING_ACCESS_CODE=change-this-access-code

# Optional: extra secret mixed into the session signing key.
# Changing it (or the access code) signs everyone out.
# SESSION_SECRET=

# Optional: image format requested from OpenAI (png | jpeg | webp). Default: png.
# Use jpeg or webp if your host limits response size (e.g. 4.5 MB on Vercel).
# IMAGE_OUTPUT_FORMAT=png

# Optional: text models for the carousel planner, tried in order (comma-separated).
# CAROUSEL_PLANNER_MODEL=gpt-6-astra,gpt-5.5

# Email Marketing (Resend). Server-only — never exposed to the browser.
# RESEND_API_KEY=re_...            (Full access key, set as Sensitive in Vercel)
# EMAIL_FROM=Intelligo ID <info@marketing.intelligo.id>
# EMAIL_REPLY_TO=team@example.com   (optional; where replies go)

# NOTE: No OpenAI API key is needed here. Users enter their own key in the UI.

# Optional: server-side OpenAI key. When set, users may leave the API key field empty.
OPENAI_API_KEY=
